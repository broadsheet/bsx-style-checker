# GEMINI_API_KEY: Required for Gemini AI API calls (local dev only).
# FIREBASE_API_KEY: Overrides the apiKey in firebase-applet-config.json (local dev only).
# In production, both are injected from GCP Secret Manager — see DEPLOY.md.
# Copy this file to .env and never commit .env.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
FIREBASE_API_KEY="MY_FIREBASE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
